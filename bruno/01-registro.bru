meta {
  name: 01 Registro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Alumno Demo",
    "email": "{{email}}",
    "password": "Password123"
  }
}

script:pre-request {
  // Email unico en cada ejecucion para evitar el 409 por duplicado
  bru.setVar("email", "alumno" + Date.now() + "@test.com");
}

script:post-response {
  if (res.status === 201) { bru.setVar("token", res.body.token); }
}

tests {
  test("201 Created", function () { expect(res.status).to.equal(201); });
  test("devuelve token", function () { expect(res.body.token).to.be.a("string"); });
  test("no expone password", function () { expect(JSON.stringify(res.body)).to.not.include("password"); });
}
